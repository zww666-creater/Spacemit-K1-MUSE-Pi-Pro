# 将本文件复制到 /home/hnu/elder_ai/elder-ai.env 后按需修改。
ELDER_AI_HOME=/home/hnu/elder_ai
WECHAT_MODEL_PATH=/home/hnu/elder_ai/models/wechat_page.onnx
CAMERA_DEVICE=/dev/video20
AUDIO_DEVICE=plughw:0,0

ORT_INTRA_OP_THREADS=8
WECHAT_INFER_INTERVAL=0.8
WECHAT_CONF_THRESHOLD=0.40
WECHAT_STABLE_FRAMES=2
WECHAT_REPEAT_SECONDS=6
CAMERA_READ_FAILURE_LIMIT=30

OCR_CAMERA_WIDTH=1280
OCR_CAMERA_HEIGHT=720
OCR_WARMUP_SECONDS=2.0
OCR_SAMPLE_FRAMES=25
OCR_USE_PROCESSED=1

KEY_OCR_GPIO=71
KEY_WECHAT_GPIO=72
KEY_PROJECT_GPIO=73
KEY_STOP_GPIO=74

# 项目完全离线运行，默认无需等网络。确有需要时再设置为正整数秒。
NETWORK_WAIT_SECONDS=0
